rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'checkship66@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints
    function isValidCompetition(data) {
      return data.keys().hasAll(['title', 'status', 'createdAt']) &&
        data.keys().hasOnly(['title', 'description', 'status', 'startTime', 'durationMinutes', 'difficulty', 'accessType', 'createdAt']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        data.status is string && data.status in ['upcoming', 'live', 'completed'] &&
        (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 64)) &&
        (!('durationMinutes' in data) || (data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 1440)) &&
        (!('difficulty' in data) || (data.difficulty is string && data.difficulty in ['Field Operator', 'Senior Analyst', 'Zero-Day Specialist', 'Classified'])) &&
        (!('accessType' in data) || (data.accessType is string && data.accessType in ['Open Clearance', 'Invite Only', 'Key Required'])) &&
        data.createdAt is timestamp;
    }

    function isValidQuestion(data, compId) {
      return data.keys().hasAll(['competitionId', 'index', 'prompt']) &&
        data.keys().hasOnly(['competitionId', 'index', 'category', 'points', 'prompt', 'codeSnippet', 'options']) &&
        data.competitionId is string && data.competitionId == compId &&
        data.index is int && data.index >= 0 && data.index <= 500 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
        (!('points' in data) || (data.points is int && data.points >= 0 && data.points <= 10000)) &&
        data.prompt is string && data.prompt.size() >= 2 && data.prompt.size() <= 2000 &&
        (!('codeSnippet' in data) || (data.codeSnippet is string && data.codeSnippet.size() <= 4000)) &&
        (!('options' in data) || data.options is list);
    }

    function isValidOperatorProfile(data, userId) {
      return data.keys().hasAll(['ownerId', 'displayName', 'username', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'displayName', 'username', 'biography', 'avatarPreset', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 48 &&
        data.username is string && data.username.size() >= 3 && data.username.size() <= 24 && data.username.matches('^[a-zA-Z0-9_.\\-]+$') &&
        (!('biography' in data) || (data.biography is string && data.biography.size() <= 280)) &&
        (!('avatarPreset' in data) || (data.avatarPreset is string && data.avatarPreset.size() <= 32)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['ownerId', 'competitionId', 'displayName', 'score', 'completionStatus', 'createdAt']) &&
        data.keys().hasOnly(['ownerId', 'competitionId', 'displayName', 'username', 'score', 'completionStatus', 'accuracyPercent', 'completionTimeSeconds', 'createdAt']) &&
        data.ownerId is string && data.ownerId == request.auth.uid &&
        isValidId(data.competitionId) &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 48 &&
        (!('username' in data) || (data.username is string && data.username.size() >= 3 && data.username.size() <= 24 && data.username.matches('^[a-zA-Z0-9_.\\-]+$'))) &&
        data.score is int && data.score >= 0 && data.score <= 1000000 &&
        data.completionStatus is string && data.completionStatus in ['Completed', 'In Progress', 'Verified'] &&
        (!('accuracyPercent' in data) || (data.accuracyPercent is int && data.accuracyPercent >= 0 && data.accuracyPercent <= 100)) &&
        (!('completionTimeSeconds' in data) || (data.completionTimeSeconds is int && data.completionTimeSeconds >= 0 && data.completionTimeSeconds <= 86400)) &&
        data.createdAt is timestamp;
    }

    function isValidCompetitionResult(data) {
      return data.keys().hasAll(['ownerId', 'competitionId', 'competitionName', 'finalScore', 'createdAt']) &&
        data.keys().hasOnly(['ownerId', 'competitionId', 'competitionName', 'finalScore', 'maxScore', 'accuracyPercent', 'timeTakenSeconds', 'correctCount', 'incorrectCount', 'createdAt']) &&
        data.ownerId is string && data.ownerId == request.auth.uid &&
        isValidId(data.competitionId) &&
        data.competitionName is string && data.competitionName.size() >= 2 && data.competitionName.size() <= 120 &&
        data.finalScore is int && data.finalScore >= 0 && data.finalScore <= 1000000 &&
        (!('maxScore' in data) || (data.maxScore is int && data.maxScore >= 0 && data.maxScore <= 1000000)) &&
        (!('accuracyPercent' in data) || (data.accuracyPercent is int && data.accuracyPercent >= 0 && data.accuracyPercent <= 100)) &&
        (!('timeTakenSeconds' in data) || (data.timeTakenSeconds is int && data.timeTakenSeconds >= 0 && data.timeTakenSeconds <= 86400)) &&
        (!('correctCount' in data) || (data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 500)) &&
        (!('incorrectCount' in data) || (data.incorrectCount is int && data.incorrectCount >= 0 && data.incorrectCount <= 500)) &&
        data.createdAt is timestamp;
    }

    // 4. Collection Rules
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /competitions/{competitionId} {
      allow get: if isValidId(competitionId) && existing().status in ['upcoming', 'live', 'completed'];
      allow list: if existing().status in ['upcoming', 'live', 'completed'];
      allow create: if isAdmin() && isValidId(competitionId) && isValidCompetition(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(competitionId) && isValidCompetition(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        existing().status != 'completed' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'status', 'startTime', 'durationMinutes', 'difficulty', 'accessType']);
      allow delete: if isAdmin() && isValidId(competitionId);

      // Master Gate Subcollection: Questions belong to a Competition
      match /questions/{questionId} {
        allow get: if isValidId(competitionId) && isValidId(questionId) &&
          exists(/databases/$(database)/documents/competitions/$(competitionId)) &&
          get(/databases/$(database)/documents/competitions/$(competitionId)).data.status in ['live', 'completed'];
        allow list: if existing().index >= 0;
        allow create: if isAdmin() && isValidId(competitionId) && isValidId(questionId) &&
          isValidQuestion(incoming(), competitionId) &&
          exists(/databases/$(database)/documents/competitions/$(competitionId));
        allow update: if isAdmin() && isValidId(competitionId) && isValidId(questionId) &&
          isValidQuestion(incoming(), competitionId) &&
          incoming().competitionId == existing().competitionId &&
          exists(/databases/$(database)/documents/competitions/$(competitionId)) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['index', 'category', 'points', 'prompt', 'codeSnippet']);
        allow delete: if isAdmin() && isValidId(competitionId) && isValidId(questionId);
      }
    }

    // Public Operator Identity Dossiers (No PII stored here)
    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(userId) &&
        isValidOperatorProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId) &&
        isValidOperatorProfile(incoming(), userId) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'username', 'biography', 'avatarPreset', 'updatedAt']);
      allow delete: if false;
    }

    // Public Leaderboard Standings
    match /leaderboard/{entryId} {
      allow get: if isValidId(entryId) && existing().score >= 0;
      allow list: if existing().score >= 0;
      allow create: if isVerifiedUser() && isValidId(entryId) &&
        isValidLeaderboardEntry(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/competitions/$(incoming().competitionId));
      allow update: if isVerifiedUser() && isValidId(entryId) &&
        isValidLeaderboardEntry(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().competitionId == existing().competitionId &&
        incoming().createdAt == existing().createdAt &&
        existing().completionStatus == 'In Progress' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['score', 'completionStatus', 'accuracyPercent', 'completionTimeSeconds']);
      allow delete: if false;
    }

    // Private Operator Results (Strictly scoped to ownerId)
    match /results/{resultId} {
      allow get: if isSignedIn() && isValidId(resultId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(resultId) &&
        isValidCompetitionResult(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/competitions/$(incoming().competitionId));
      allow update, delete: if false;
    }
  }
}
