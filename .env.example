# Server & Deployment Configuration
PORT=3000
NODE_ENV=production
PYTHON_PORT=5001
# Optional: specify python binary if needed ('python' or 'python3')
# PYTHON_CMD=python3

# Client-Side Firebase Web Configuration (Safe public credentials prefixed with VITE_)
# Defaults are loaded from firebase-applet-config.json if not specified here.
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# AI Studio / External Services (Optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
